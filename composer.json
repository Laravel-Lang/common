{
    "name": "laravel-lang/common",
    "description": "Easily connect the necessary language packs to the application",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel-lang",
        "attributes",
        "http-status-codes",
        "i18n",
        "lang",
        "language",
        "locale",
        "locales",
        "localization",
        "translation",
        "translations"
    ],
    "authors": [
        {
            "name": "Andrey Helldar",
            "email": "helldar@dragon-code.pro"
        },
        {
            "name": "Laravel-Lang Team",
            "homepage": "https://github.com/Laravel-Lang"
        }
    ],
    "support": {
        "source": "https://github.com/Laravel-Lang/mona"
    },
    "require": {
        "php": "^8.3",
        "laravel-lang/actions": "self.version",
        "laravel-lang/attributes": "self.version",
        "laravel-lang/country-names": "self.version",
        "laravel-lang/currency-names": "self.version",
        "laravel-lang/http-statuses": "self.version",
        "laravel-lang/json-fallback": "self.version",
        "laravel-lang/lang": "self.version",
        "laravel-lang/locale-names": "self.version",
        "laravel-lang/locales": "self.version",
        "laravel-lang/models": "self.version",
        "laravel-lang/moonshine": "self.version",
        "laravel-lang/routes": "self.version",
        "laravel-lang/starter-kits": "self.version"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    }
}
